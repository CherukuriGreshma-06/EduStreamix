<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= displaySubject || 'Study' %> — EduStreamix</title>

  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>

  <!-- NAVBAR -->
  <nav>
    <a href="/">🎓 EduStreamix</a>
    <a href="/">Home</a>
  </nav>

  <main>

    <!-- HEADER -->
    <h1><%= displaySubject || 'Subject' %></h1>

    <!-- CHAPTERS SECTION -->
    <div id="chaptersSection">
      <div id="chaptersContainer"></div>
    </div>

    <!-- VIDEO SECTION -->
    <div id="videoSection" style="display:none;">
      <button onclick="goBack()">⬅ Back to Chapters</button>

      <h2 id="videoTitle"></h2>

      <iframe
        id="videoFrame"
        width="800"
        height="450"
        frameborder="0"
        allowfullscreen>
      </iframe>
    </div>

  </main>

  <!-- GLOBAL DATA -->
  <script>
    window.__GRADE__ = '<%= selectedGrade || 10 %>';
    window.__SUBJECT__ = '<%= selectedSubject || "" %>';
    window.__DISPLAY_SUBJECT__ = '<%= displaySubject || "" %>';
  </script>

  <!-- MAIN JS -->
  <script src="/js/app.js"></script>

  <!-- SIMPLE BACK FUNCTION -->
  <script>
    function goBack() {
      document.getElementById('videoSection').style.display = 'none';
      document.getElementById('chaptersSection').style.display = '';
    }
  </script>

</body>
</html>