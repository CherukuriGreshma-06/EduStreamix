<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Select your board — SSC, CBSE, or ICSE — on EduStreamix." />
  <title>Select Your Board — EduStreamix</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="step-body">

  <nav class="navbar scrolled" id="navbar">
    <a href="/" class="nav-brand">
      <span class="brand-icon">🎓</span>
      <span class="brand-text">EduStreami<span class="brand-x">x</span></span>
    </a>
    <div class="nav-links nav-actions">
      <select class="nav-lang-switcher" id="nav-lang-switcher">
        <option value="English">English</option>
        <option value="Hindi">हिंदी</option>
        <option value="Telugu">తెలుగు</option>
        <option value="Tamil">தமிழ்</option>
        <option value="Kannada">ಕನ್ನಡ</option>
        <option value="Malayalam">മലയാളം</option>
      </select>
      <a href="/" class="nav-home-btn" aria-label="Home">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5v9A1.5 1.5 0 0 1 19.5 21h-5v-6h-5v6h-5A1.5 1.5 0 0 1 3 19.5v-9Z"/></svg>
        <span>Home</span>
      </a>
    </div>
  </nav>

  <main class="step-main">
    <div class="step-container">

      <div class="step-header">
        <h1 class="step-title"><span data-i18n="Select Your Board">Select Your Board</span></h1>
        <p class="step-subtitle strong-subtitle" data-i18n="Choose your education board to see relevant subjects">Choose your education board to see relevant subjects</p>
      </div>

      <div class="board-grid" id="board-grid">
        <a href="/subjects?grade=<%= selectedGrade %>&board=SSC" class="board-card" id="board-card-ssc">
          <div class="board-card-glow"></div>
          <span class="board-icon">🏫</span>
          <h3 class="board-card-title" data-i18n="SSC">SSC</h3>
          <p class="board-card-label" data-i18n="State Board">State Board</p>
          <span class="board-card-arrow">→</span>
        </a>
        <a href="/subjects?grade=<%= selectedGrade %>&board=CBSE" class="board-card" id="board-card-cbse">
          <div class="board-card-glow"></div>
          <span class="board-icon">📘</span>
          <h3 class="board-card-title" data-i18n="CBSE">CBSE</h3>
          <p class="board-card-label" data-i18n="Central Board">Central Board</p>
          <span class="board-card-arrow">→</span>
        </a>
        <a href="/subjects?grade=<%= selectedGrade %>&board=ICSE" class="board-card" id="board-card-icse">
          <div class="board-card-glow"></div>
          <span class="board-icon">🎓</span>
          <h3 class="board-card-title" data-i18n="ICSE">ICSE</h3>
          <p class="board-card-label" data-i18n="Indian Certificate">Indian Certificate</p>
          <span class="board-card-arrow">→</span>
        </a>
      </div>

      <div class="bottom-nav">
        <a href="/" class="flow-btn">Back</a>
        <button type="button" class="flow-btn flow-btn-disabled" disabled>Next</button>
      </div>

    </div>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-brand">🎓 EduStreami<span class="brand-x">x</span></span>
      <span class="footer-copy">&copy; 2026 EduStreamix. Built for learners.</span>
    </div>
  </footer>

  <script src="/js/i18n.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const switcher = document.getElementById('nav-lang-switcher');
      if (switcher) {
        const lang = localStorage.getItem('appLang') || 'English';
        switcher.value = lang;

        switcher.addEventListener('change', (e) => {
          const selected = e.target.value;
          if (window.applyLanguage) {
            window.applyLanguage(selected);
          } else {
            localStorage.setItem('appLang', selected);
            window.location.reload();
          }
        });
      }
    });
  </script>
</body>
</html>
